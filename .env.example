# Copy to .env and fill in. No value here is a real credential.
# FILESTASH_SECRET_KEY must match [a-zA-Z0-9]{16}.
FILESTASH_SECRET_KEY=
# FILESTASH_ADMIN_BCRYPT must be a bcrypt hash; an empty auth.admin sends every
# visitor to /admin/setup.
FILESTASH_ADMIN_BCRYPT=
# GCS HMAC key for a service account with objectViewer on kenya-forecasting-data.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Bucket to browse, bare name with no leading slash; the entrypoint adds it.
S3_BUCKET=
